{
  "name": "dsh-pet-gujiguji",
  "version": "0.8.2",
  "type": "module",
  "description": "GujiGuji desktop pet for DeepSeek Harness: a lightweight bird companion that reacts to the active agent status, mirroring the Codex desktop pet.",
  "license": "MIT",
  "author": "7AAAAAH",
  "icon": "./assets/icon-180.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7AAAAAH/dsh-pet-gujiguji.git"
  },
  "bugs": {
    "url": "https://github.com/7AAAAAH/dsh-pet-gujiguji/issues"
  },
  "homepage": "https://github.com/7AAAAAH/dsh-pet-gujiguji#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "virtual-pet",
    "gujiguji",
    "bird",
    "windows"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon-180.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/spritesheet.webp",
    "assets/spritesheet.png",
    "assets/icon-180.png",
    "assets/screenshot-1.png",
    "assets/poses/idle_*.png",
    "assets/poses/head-tilt_*.png",
    "assets/poses/head-stretch_*.png",
    "assets/poses/cheer_*.png",
    "assets/poses/wave_*.png",
    "assets/poses/sources/*.png",
    "assets/poses/idle.png",
    "assets/poses/poses.json",
    "desktop/dsh-pet-gujiguji-*.exe",
    "desktop/pet-window.pyw",
    "desktop/pet_physics.py",
    "desktop/dsh-pet-gujiguji.spec",
    "desktop/default-settings.json",
    "desktop/start-pet.ps1",
    "desktop/setup-startup.ps1",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "docs/DEVELOPMENT-PLAN.zh.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "manifestVersion": 1
  }
}
